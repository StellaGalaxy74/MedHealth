rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function existingData() { return resource.data; }
    function incomingData() { return request.resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
             data.id == request.auth.uid &&
             data.name is string && data.name.size() > 0 &&
             data.email is string &&
             data.role in ['patient', 'doctor'];
    }

    function isValidRecord(data) {
      return data.keys().hasAll(['id', 'patientId', 'fileURL', 'type', 'createdAt']) &&
             data.patientId == request.auth.uid &&
             data.fileURL is string &&
             data.type in ['prescription', 'report'];
    }

    function isValidReminder(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'time', 'type', 'completed', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 &&
             data.time is string &&
             data.type in ['medication', 'appointment', 'general'] &&
             data.completed is bool;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(incomingData());
      allow update: if isOwner(userId) && isValidUser(incomingData());
      allow delete: if false;
    }

    // Reminders Collection
    match /reminders/{reminderId} {
      allow read, write: if isSignedIn() && (
        (exists(resource) && resource.data.userId == request.auth.uid) ||
        (request.resource.data.userId == request.auth.uid)
      );
    }

    // Records Collection
    match /records/{recordId} {
      // Patients read their own records
      // Doctors read if sharing is enabled
      allow get: if isSignedIn() && (
        isOwner(existingData().patientId) ||
        (get(/databases/$(database)/documents/users/$(existingData().patientId)).data.sharingEnabled == true)
      );
      
      allow list: if isSignedIn() && (
        (isOwner(request.query.limit(10).toFetch().patientId)) || // Error prone, better use resource.data in collection group or specific path
        // Simplified list for demo:
        (resource.data.patientId == request.auth.uid) ||
        (get(/databases/$(database)/documents/users/$(resource.data.patientId)).data.sharingEnabled == true)
      );

      allow create: if isSignedIn() && isOwner(incomingData().patientId) && isValidRecord(incomingData());
      allow update: if isOwner(existingData().patientId) && isValidRecord(incomingData());
      allow delete: if isOwner(existingData().patientId);
    }
  }
}
