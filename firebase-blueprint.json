{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user profile for both Patients and Doctors.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "age": { "type": "integer" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "address": { "type": "string" },
        "degree": { "type": "string" },
        "sharingEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "Health documents uploaded by patients.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "fileURL": { "type": "string", "format": "uri" },
        "fileName": { "type": "string" },
        "type": { "type": "string", "enum": ["prescription", "report"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "fileURL", "type", "createdAt"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Health reminders and tasks for users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string", "enum": ["medication", "appointment", "general"] },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "time", "type", "completed", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by UID."
    },
    "/records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Medical records repository."
    },
    "/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "User specific health reminders."
    }
  }
}
